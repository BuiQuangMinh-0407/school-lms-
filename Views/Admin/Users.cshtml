@model List<SchoolManagement.Models.ApplicationUser>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-people me-2"></i>User Management</h4>
    <a href="/Admin/CreateUser" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New User</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Full Name</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Lockout</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-semibold">@user.FullName</td>
                        <td><code>@user.Username</code></td>
                        <td>@user.Email</td>
                        <td>
                            <span class="badge @(user.Role == SchoolManagement.Models.UserRole.Admin ? "bg-danger" : user.Role == SchoolManagement.Models.UserRole.Teacher ? "bg-primary" : "bg-success")">
                                @user.Role
                            </span>
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-slash-circle me-1"></i>Inactive</span>
                            }
                        </td>
                        <td>
                            @if (user.LockoutEnd.HasValue && user.LockoutEnd > DateTime.UtcNow)
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-lock me-1"></i>Locked</span>
                                <form method="post" asp-action="UnlockUser" asp-route-id="@user.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning ms-1">Unlock</button>
                                </form>
                            }
                            else if (user.FailedLoginAttempts > 0)
                            {
                                <span class="text-warning small">@user.FailedLoginAttempts failed</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <a href="/Admin/EditUser/@user.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#resetModal-@user.Id">
                                <i class="bi bi-key"></i>
                            </button>
                        </td>
                    </tr>

                    <!-- Reset Password Modal -->
                    <div class="modal fade" id="resetModal-@user.Id" tabindex="-1">
                        <div class="modal-dialog modal-sm">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h6 class="modal-title">Reset Password – @user.Username</h6>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form method="post" asp-action="ResetPassword" asp-route-id="@user.Id">
                                    @Html.AntiForgeryToken()
                                    <div class="modal-body">
                                        <input type="password" name="newPassword" class="form-control" placeholder="New password" minlength="8" required />
                                    </div>
                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-warning btn-sm">Reset</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>

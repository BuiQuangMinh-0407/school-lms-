@model SchoolManagement.ViewModels.CreateUserViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Thêm Người Dùng";
}

<div class="d-flex align-items-center mb-4">
    <a href="/Admin/Users" class="btn-wb-outline me-3"><i class="bi bi-arrow-left"></i> Quay lại</a>
    <div>
        <h2 class="fw-bold mb-0" style="font-size:1.3rem;color:#0F172A;">Tạo Người Dùng Mới</h2>
        <small class="text-muted">Cấp tài khoản đăng nhập và phân quyền hệ thống</small>
    </div>
</div>

<div class="wb-card p-4" style="max-width:580px;">
    <form asp-action="CreateUser" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger py-2" style="border-radius:10px;font-size:0.88rem;"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label fw-bold small text-muted"></label>
            <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-bold small text-muted"></label>
            <input asp-for="Email" class="form-control" type="email" placeholder="user@neu.edu.vn" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Role" class="form-label fw-bold small text-muted"></label>
            <select asp-for="Role" class="form-select">
                <option value="SinhVien">Sinh Viên (Student)</option>
                <option value="GiangVien">Giảng Viên (Teacher)</option>
                <option value="Admin">Quản Trị Viên (Admin)</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Code" class="form-label fw-bold small text-muted"></label>
            <input asp-for="Code" class="form-control" placeholder="Ví dụ: GV001, SV001 (để trống sẽ tự sinh)" />
            <span asp-validation-for="Code" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-bold small text-muted"></label>
            <input asp-for="Password" class="form-control" type="password" placeholder="Tối thiểu 6 ký tự" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label fw-bold small text-muted"></label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Nhập lại mật khẩu" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn-wb-primary w-100 py-2">
            <i class="bi bi-person-check-fill me-1"></i> Tạo Tài Khoản
        </button>
    </form>
</div>

@model SchoolManagement.ViewModels.ClassDetailViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Lớp: " + Model.Class.TenLop;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center">
        <a href="/Admin/Classes" class="btn-wb-outline me-3"><i class="bi bi-arrow-left"></i> Quay lại</a>
        <div>
            <h2 class="fw-bold mb-0" style="font-size:1.35rem;color:#0F172A;">@Model.Class.TenLop</h2>
            <small class="text-muted">Mã: <strong>@Model.Class.MaLop</strong> | HK @Model.Class.HocKy (@Model.Class.NamHoc) | Sĩ số tối đa: @Model.Class.SiSoToiDa</small>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Teachers -->
    <div class="col-md-6">
        <div class="wb-card h-100">
            <div class="wb-card-header">
                <div class="wb-card-title">
                    <i class="bi bi-person-workspace text-primary"></i>
                    <span>Giảng Viên Phụ Trách (@Model.Teachers.Count)</span>
                </div>
                <a href="/Admin/AddTeacher?classId=@Model.Class.LopHocId" class="btn-wb-outline" style="font-size:0.8rem;padding:4px 10px;">
                    <i class="bi bi-plus-lg"></i> Phân Công
                </a>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var t in Model.Teachers)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width:32px;height:32px;border-radius:50%;background:#EFF6FF;color:#2563EB;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;">
                                GV
                            </div>
                            <div>
                                <span class="fw-bold">@t.HoTen</span>
                                <small class="text-muted d-block font-monospace">@t.MaGiangVien - @t.Email</small>
                            </div>
                        </div>
                        <form method="post" asp-action="RemoveTeacher" asp-route-classId="@Model.Class.LopHocId" asp-route-teacherId="@t.GiangVienId">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Hủy phân công giảng viên này?')" title="Hủy phân công">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </form>
                    </li>
                }
                @if (!Model.Teachers.Any())
                {
                    <li class="list-group-item text-muted text-center py-4">Chưa có giảng viên nào được phân công.</li>
                }
            </ul>
        </div>
    </div>

    <!-- Students -->
    <div class="col-md-6">
        <div class="wb-card h-100">
            <div class="wb-card-header">
                <div class="wb-card-title">
                    <i class="bi bi-people-fill text-success"></i>
                    <span>Sinh Viên Trong Lớp (@Model.Students.Count)</span>
                </div>
                <a href="/Admin/AddStudent?classId=@Model.Class.LopHocId" class="btn-wb-outline" style="font-size:0.8rem;padding:4px 10px;">
                    <i class="bi bi-plus-lg"></i> Thêm SV
                </a>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var s in Model.Students)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width:32px;height:32px;border-radius:50%;background:#ECFDF5;color:#059669;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;">
                                SV
                            </div>
                            <div>
                                <span class="fw-bold">@s.HoTen</span>
                                <small class="text-muted d-block font-monospace">@s.MaSinhVien - @s.Email</small>
                            </div>
                        </div>
                        <form method="post" asp-action="RemoveStudent" asp-route-classId="@Model.Class.LopHocId" asp-route-studentId="@s.SinhVienId">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Xóa sinh viên khỏi lớp?')" title="Xóa sinh viên">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </form>
                    </li>
                }
                @if (!Model.Students.Any())
                {
                    <li class="list-group-item text-muted text-center py-4">Chưa có sinh viên nào trong lớp.</li>
                }
            </ul>
        </div>
    </div>

    <!-- Lessons overview -->
    <div class="col-md-6">
        <div class="wb-card">
            <div class="wb-card-header">
                <div class="wb-card-title">
                    <i class="bi bi-journal-richtext text-info"></i>
                    <span>Bài Học (@Model.Lessons.Count)</span>
                </div>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var l in Model.Lessons)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span>@l.TieuDe</span>
                        <span class="wb-badge @(l.DaXuatBan ? "success" : "")" style="@(l.DaXuatBan ? "" : "background:#F1F5F9;color:#64748B;")">
                            @(l.DaXuatBan ? "Đã xuất bản" : "Bản nháp")
                        </span>
                    </li>
                }
                @if (!Model.Lessons.Any())
                {
                    <li class="list-group-item text-muted text-center py-3">Chưa có bài học nào.</li>
                }
            </ul>
        </div>
    </div>

    <!-- Assignments overview -->
    <div class="col-md-6">
        <div class="wb-card">
            <div class="wb-card-header">
                <div class="wb-card-title">
                    <i class="bi bi-clipboard-check text-warning"></i>
                    <span>Bài Tập (@Model.Assignments.Count)</span>
                </div>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var a in Model.Assignments)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span>@a.TieuDe</span>
                        <small class="text-muted">Hạn nộp: @(a.HanNop?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Không có")</small>
                    </li>
                }
                @if (!Model.Assignments.Any())
                {
                    <li class="list-group-item text-muted text-center py-3">Chưa có bài tập nào.</li>
                }
            </ul>
        </div>
    </div>
</div>

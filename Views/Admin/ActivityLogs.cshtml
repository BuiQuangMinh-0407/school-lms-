@model List<SchoolManagement.Models.DBNew2026.NhatKyDangNhap>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Nhật Ký Đăng Nhập";
    int currentPage = (int)ViewBag.Page;
    int total       = (int)ViewBag.TotalLogs;
    int pageSize    = (int)ViewBag.PageSize;
    int totalPages  = (int)Math.Ceiling((double)total / pageSize);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="font-size:1.4rem;color:#0F172A;">Nhật Ký Đăng Nhập (NhatKyDangNhap)</h2>
        <div class="text-muted small">Ghi nhận mọi lần đăng nhập thành công và thất bại theo yêu cầu bảo mật</div>
    </div>
    <div class="text-muted small">
        <i class="bi bi-database me-1"></i>Tổng cộng: <strong>@total</strong> bản ghi
    </div>
</div>

<div class="wb-card">
    <div class="table-responsive">
        <table class="wb-table">
            <thead>
                <tr>
                    <th>Thời Điểm</th>
                    <th>Email Tài Khoản</th>
                    <th>Trạng Thái</th>
                    <th>Lý Do / Sự Kiện</th>
                    <th>Địa Chỉ IP</th>
                    <th>Mã Tài Khoản</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td><span class="text-muted small">@log.ThoiDiem.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span></td>
                        <td><strong>@log.Email</strong></td>
                        <td>
                            @if (log.ThanhCong)
                            {
                                <span class="wb-badge success"><i class="bi bi-check-circle-fill"></i> Thành công</span>
                            }
                            else
                            {
                                <span class="wb-badge failed"><i class="bi bi-x-circle-fill"></i> Thất bại</span>
                            }
                        </td>
                        <td>
                            <code style="background:#EFF6FF;color:#1D4ED8;padding:2px 8px;border-radius:6px;font-size:0.85rem;">
                                @log.LyDo
                            </code>
                        </td>
                        <td><span class="text-muted font-monospace small">@(log.DiaChiIp ?? "—")</span></td>
                        <td><span class="text-muted small">@(log.TaiKhoanId.HasValue ? $"#{log.TaiKhoanId}" : "—")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @{
        var prevPage = currentPage - 1;
        var nextPage = currentPage + 1;
    }
    <div class="p-3 border-top d-flex justify-content-between align-items-center">
        <small class="text-muted">Trang @currentPage / @(totalPages == 0 ? 1 : totalPages)</small>
        <div class="d-flex gap-2">
            @if (currentPage > 1)
            {
                <a href="/Admin/ActivityLogs?page=@prevPage" class="btn-wb-outline py-1 px-3">
                    <i class="bi bi-chevron-left"></i> Trang trước
                </a>
            }
            @if (currentPage < totalPages)
            {
                <a href="/Admin/ActivityLogs?page=@nextPage" class="btn-wb-outline py-1 px-3">
                    Trang sau <i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>
    </div>
</div>

@model SchoolManagement.ViewModels.ClassDetailViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Class.Name;
}

<div class="d-flex align-items-center mb-4">
    <a href="/Teacher/Index" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
    <div>
        <h4 class="mb-0">@Model.Class.Name</h4>
        <small class="text-muted">@Model.Class.Description</small>
    </div>
</div>

<div class="row g-4">
    <!-- Lessons -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-journal-richtext me-2"></i>Lessons</span>
                <a href="/Teacher/CreateLesson?classId=@Model.Class.Id" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus"></i> New
                </a>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var l in Model.Lessons)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">@l.Title</div>
                                <small class="text-muted">Created @l.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                            </div>
                            <div class="d-flex flex-column align-items-end gap-1">
                                <span class="badge @(l.IsPublished ? "bg-success" : "bg-secondary")">
                                    @(l.IsPublished ? "Published" : "Draft")
                                </span>
                                <div class="btn-group btn-group-sm mt-1">
                                    <a href="/Teacher/EditLesson/@l.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                                    @if (!l.IsPublished)
                                    {
                                        <form method="post" asp-action="PublishLesson" asp-controller="Teacher" asp-route-id="@l.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm">Publish</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-action="UnpublishLesson" asp-controller="Teacher" asp-route-id="@l.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning btn-sm">Unpublish</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </li>
                }
                @if (!Model.Lessons.Any())
                {
                    <li class="list-group-item text-muted">No lessons yet.</li>
                }
            </ul>
        </div>
    </div>

    <!-- Assignments -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clipboard-check me-2"></i>Assignments</span>
                <a href="/Teacher/CreateAssignment?classId=@Model.Class.Id" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-plus"></i> New
                </a>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var a in Model.Assignments)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold">@a.Title</div>
                            <small class="text-muted">Due @a.DueDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <a href="/Teacher/Submissions/@a.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-list-check me-1"></i>Submissions
                        </a>
                    </li>
                }
                @if (!Model.Assignments.Any())
                {
                    <li class="list-group-item text-muted">No assignments yet.</li>
                }
            </ul>
        </div>
    </div>

    <!-- Students -->
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header"><i class="bi bi-people me-2"></i>Enrolled Students (@Model.Students.Count)</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Name</th><th>Username</th><th>Email</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Students)
                        {
                            <tr>
                                <td>@s.FullName</td>
                                <td><code>@s.Username</code></td>
                                <td>@s.Email</td>
                            </tr>
                        }
                        @if (!Model.Students.Any())
                        {
                            <tr><td colspan="3" class="text-muted">No students enrolled.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

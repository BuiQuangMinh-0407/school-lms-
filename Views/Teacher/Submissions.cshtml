@model List<SchoolManagement.Models.DBNew2026.BaiNop>
@{
    Layout = "_Layout";
    var assignment = (SchoolManagement.Models.DBNew2026.BaiTap)ViewBag.Assignment;
    ViewData["Title"] = "Bài nộp: " + assignment.TieuDe;
}

<div class="d-flex align-items-center mb-4">
    <a href="/Teacher/ClassDetail/@assignment.LopHocId" class="btn-wb-outline me-3"><i class="bi bi-arrow-left"></i> Quay lại</a>
    <div>
        <h2 class="fw-bold mb-0" style="font-size:1.35rem;color:#0F172A;">@assignment.TieuDe</h2>
        <small class="text-muted">Hạn nộp: @(assignment.HanNop?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Không có")</small>
    </div>
</div>

<div class="wb-card">
    <div class="table-responsive">
        <table class="wb-table">
            <thead>
                <tr>
                    <th>Sinh Viên</th>
                    <th>Thời Điểm Nộp</th>
                    <th>Trạng Thái</th>
                    <th>Điểm Số</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sub in Model)
                {
                    <tr>
                        <td>
                            <div>
                                <span class="fw-bold">@sub.SinhVien.HoTen</span>
                                <small class="text-muted d-block font-monospace">@sub.SinhVien.MaSinhVien</small>
                            </div>
                        </td>
                        <td>@sub.NgayNop.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (sub.Diem.HasValue)
                            {
                                <span class="wb-badge success"><i class="bi bi-check-circle-fill"></i> Đã chấm</span>
                            }
                            else
                            {
                                <span class="wb-badge" style="background:#FEF3C7;color:#D97706;"><i class="bi bi-clock-fill"></i> Chờ chấm</span>
                            }
                        </td>
                        <td>
                            @if (sub.Diem.HasValue)
                            {
                                <strong style="color:#059669;font-size:1rem;">@sub.Diem / 10</strong>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <a href="/Teacher/Grade/@sub.BaiNopId" class="btn-wb-outline py-1 px-3" style="font-size:0.85rem;">
                                <i class="bi bi-pencil-square me-1"></i>@(sub.Diem.HasValue ? "Chấm lại" : "Chấm điểm")
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Chưa có sinh viên nào nộp bài.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

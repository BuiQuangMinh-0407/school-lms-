@model List<SchoolManagement.Models.DBNew2026.LopHoc>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Lớp Giảng Dạy";
}

<div class="wb-welcome-banner mb-4">
    <div>
        <div class="wb-welcome-title"><i class="bi bi-person-workspace me-2"></i>Lớp Giảng Dạy Của Tôi</div>
        <div class="wb-welcome-sub">Bạn đang phụ trách @Model.Count lớp học trong học kỳ này.</div>
    </div>
</div>

<div class="row g-4">
    @foreach (var cls in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="wb-card h-100 d-flex flex-column mb-0" style="padding: 24px;">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="wb-stat-icon indigo" style="width:48px;height:48px;font-size:1.3rem;">
                        <i class="bi bi-book-half"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0" style="color:#0F172A;font-size:1.1rem;">@cls.TenLop</h5>
                        <small class="text-muted">Mã lớp: <strong>@cls.MaLop</strong> | HK @cls.HocKy (@cls.NamHoc)</small>
                    </div>
                </div>

                <div class="text-muted small mb-4 pb-3" style="border-bottom:1.5px solid #F1F5F9;">
                    <i class="bi bi-people-fill text-success me-1"></i>
                    <strong>@cls.SinhVienLops.Count</strong> sinh viên đã ghi danh
                </div>

                <a href="/Teacher/ClassDetail/@cls.LopHocId" class="btn-wb-primary w-100 justify-content-center py-2 mt-auto">
                    <i class="bi bi-door-open-fill me-1"></i> Vào Lớp Học
                </a>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info" style="border-radius:14px;border:none;background:#EFF6FF;color:#1E40AF;">
                <i class="bi bi-info-circle-fill me-2"></i> Bạn chưa được phân công phụ trách lớp học nào. Vui lòng liên hệ quản trị viên.
            </div>
        </div>
    }
</div>

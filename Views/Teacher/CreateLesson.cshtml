@model SchoolManagement.ViewModels.CreateLessonViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Tạo Bài Học";
}

<div class="d-flex align-items-center mb-4">
    <a href="/Teacher/ClassDetail/@Model.ClassId" class="btn-wb-outline me-3"><i class="bi bi-arrow-left"></i> Quay lại</a>
    <div>
        <h2 class="fw-bold mb-0" style="font-size:1.3rem;color:#0F172A;">Thêm Bài Học Mới</h2>
        <small class="text-muted">Soạn thảo tài liệu và bài giảng cho sinh viên</small>
    </div>
</div>

<div class="wb-card p-4">
    <form asp-action="CreateLesson" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="ClassId" type="hidden" />
        <div asp-validation-summary="All" class="alert alert-danger py-2" style="border-radius:10px;font-size:0.88rem;"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-bold small text-muted"></label>
            <input asp-for="Title" class="form-control" placeholder="Ví dụ: Bài 1 - Giới thiệu về bảo mật web" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Content" class="form-label fw-bold small text-muted"></label>
            <textarea asp-for="Content" class="form-control" rows="12" placeholder="Nhập nội dung bài học chi tiết..."></textarea>
            <span asp-validation-for="Content" class="text-danger small"></span>
        </div>

        <div class="mb-4 form-check">
            <input asp-for="IsPublished" class="form-check-input" type="checkbox" id="pubCheck" />
            <label for="pubCheck" class="form-check-label fw-bold small text-success">Xuất bản ngay để sinh viên có thể xem được</label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-wb-primary py-2 px-4">
                <i class="bi bi-save-fill me-1"></i> Lưu Bài Học
            </button>
            <a href="/Teacher/ClassDetail/@Model.ClassId" class="btn-wb-outline py-2 px-3">Hủy</a>
        </div>
    </form>
</div>

@model SchoolManagement.ViewModels.CreateLessonViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Lesson";
}

<div class="d-flex align-items-center mb-4">
    <a href="/Teacher/ClassDetail/@Model.ClassId" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
    <h4 class="mb-0"><i class="bi bi-journal-plus me-2"></i>Create Lesson</h4>
</div>

<div class="card p-4">
    <form asp-action="CreateLesson" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="ClassId" type="hidden" />
        <div asp-validation-summary="All" class="alert alert-danger py-2"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-semibold"></label>
            <input asp-for="Title" class="form-control" placeholder="Lesson title" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Content" class="form-label fw-semibold">Content</label>
            <textarea asp-for="Content" class="form-control" rows="12" placeholder="Write lesson content here..."></textarea>
            <span asp-validation-for="Content" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save me-1"></i>Save as Draft
            </button>
            <a href="/Teacher/ClassDetail/@Model.ClassId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

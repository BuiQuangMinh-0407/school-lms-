<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – School Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background: #f4f6f9; }
        .sidebar { min-height: 100vh; background: #1a1a2e; color: #ccc; }
        .sidebar a { color: #ccc; text-decoration: none; padding: 10px 20px; display: block; border-radius: 6px; margin: 2px 8px; transition: background .2s; }
        .sidebar a:hover, .sidebar a.active { background: #0f3460; color: #fff; }
        .sidebar .brand { font-size: 1.2rem; font-weight: 700; color: #e94560; padding: 20px; border-bottom: 1px solid #333; }
        .nav-label { font-size: .7rem; text-transform: uppercase; letter-spacing: 1px; color: #666; padding: 14px 20px 4px; }
        .main-content { padding: 30px; }
        .card { border: none; box-shadow: 0 1px 6px rgba(0,0,0,.08); border-radius: 12px; }
        .stat-card { border-left: 4px solid; }
        .badge-admin { background: #dc3545; }
        .badge-teacher { background: #0d6efd; }
        .badge-student { background: #198754; }
    </style>
</head>
<body>
<div class="d-flex">
    @if (Context.Session.GetInt32("UserId") != null)
    {
        <div class="sidebar d-flex flex-column" style="width:220px;min-width:220px">
            <div class="brand"><i class="bi bi-mortarboard-fill me-2"></i>SchoolMS</div>

            @{
                var role = Context.Session.GetString("UserRole");
                var uname = Context.Session.GetString("Username");
            }

            @if (role == "Admin")
            {
                <span class="nav-label">Admin</span>
                <a href="/Admin/Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
                <a href="/Admin/Users"><i class="bi bi-people me-2"></i>Users</a>
                <a href="/Admin/Classes"><i class="bi bi-collection me-2"></i>Classes</a>
                <a href="/Admin/ActivityLogs"><i class="bi bi-journal-text me-2"></i>Activity Logs</a>
            }
            else if (role == "Teacher")
            {
                <span class="nav-label">Teacher</span>
                <a href="/Teacher/Index"><i class="bi bi-speedometer2 me-2"></i>My Classes</a>
            }
            else
            {
                <span class="nav-label">Student</span>
                <a href="/Student/Index"><i class="bi bi-speedometer2 me-2"></i>My Classes</a>
                <a href="/Student/MyGrades"><i class="bi bi-patch-check me-2"></i>My Grades</a>
            }

            <span class="nav-label">Account</span>
            <a href="/Account/ChangePassword"><i class="bi bi-key me-2"></i>Change Password</a>

            <div class="mt-auto p-3 border-top border-secondary">
                <small class="text-muted d-block">Logged in as</small>
                <strong class="text-white">@uname</strong>
                <span class="badge ms-1 @(role == "Admin" ? "badge-admin" : role == "Teacher" ? "badge-teacher" : "badge-student")">@role</span>
                <form method="post" action="/Account/Logout" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                </form>
            </div>
        </div>
    }

    <div class="flex-grow-1 main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

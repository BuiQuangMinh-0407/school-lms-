<!DOCTYPE html>
<html lang="en" data-bs-theme="light" style="color-scheme: light !important;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – SchoolMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/lms-theme.css" />
</head>
<body data-bs-theme="light" style="color-scheme: light !important; background-color: #F1F5F9 !important;">
<div class="lms-layout">

    @if (Context.Session.GetInt32("UserId") != null)
    {
        var role  = Context.Session.GetString("UserRole");
        var uname = Context.Session.GetString("Username") ?? "User";
        var initials = uname.Length >= 2 ? uname.Substring(0,2).ToUpper() : uname.ToUpper();
        var currentPath = Context.Request.Path.Value ?? "";

        <!-- ── SIDEBAR (Clean White & Blue Theme) ──────────────── -->
        <aside class="lms-sidebar">
            <!-- Brand -->
            <div class="lms-brand">
                <div class="lms-brand-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <div class="lms-brand-text">
                    <span class="lms-brand-name">SchoolMS</span>
                    <span class="lms-brand-desc">LMS Platform</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="lms-nav">
                @if (role == "Admin")
                {
                    <span class="lms-nav-header">Quản Trị</span>
                    <a href="/Admin/Index" class="lms-nav-item @(currentPath == "/Admin/Index" || currentPath == "/" ? "active" : "")">
                        <i class="bi bi-grid-fill"></i><span>Dashboard</span>
                    </a>
                    <a href="/Admin/Users" class="lms-nav-item @(currentPath.StartsWith("/Admin/Users") || currentPath.StartsWith("/Admin/CreateUser") || currentPath.StartsWith("/Admin/EditUser") ? "active" : "")">
                        <i class="bi bi-people-fill"></i><span>Người Dùng</span>
                    </a>
                    <a href="/Admin/Classes" class="lms-nav-item @(currentPath.StartsWith("/Admin/Classes") || currentPath.StartsWith("/Admin/ClassDetail") ? "active" : "")">
                        <i class="bi bi-book-half"></i><span>Lớp Học</span>
                    </a>

                    <span class="lms-nav-header">Giám Sát</span>
                    <a href="/Admin/ActivityLogs" class="lms-nav-item @(currentPath.StartsWith("/Admin/ActivityLogs") ? "active" : "")">
                        <i class="bi bi-journal-text"></i><span>Nhật Ký Hoạt Động</span>
                    </a>
                }
                else if (role == "Teacher" || role == "GiangVien")
                {
                    <span class="lms-nav-header">Giảng Dạy</span>
                    <a href="/Teacher/Index" class="lms-nav-item @(currentPath == "/Teacher/Index" || currentPath == "/" ? "active" : "")">
                        <i class="bi bi-book-half"></i><span>Lớp Dạy Của Tôi</span>
                    </a>
                }
                else
                {
                    <span class="lms-nav-header">Học Tập</span>
                    <a href="/Student/Index" class="lms-nav-item @(currentPath == "/Student/Index" || currentPath == "/" ? "active" : "")">
                        <i class="bi bi-book-half"></i><span>Lớp Học Của Tôi</span>
                    </a>
                    <a href="/Student/MyGrades" class="lms-nav-item @(currentPath == "/Student/MyGrades" ? "active" : "")">
                        <i class="bi bi-patch-check-fill"></i><span>Bảng Điểm</span>
                    </a>
                }

                <span class="lms-nav-header">Tài Khoản</span>
                <a href="/Account/ChangePassword" class="lms-nav-item @(currentPath == "/Account/ChangePassword" ? "active" : "")">
                    <i class="bi bi-shield-lock-fill"></i><span>Đổi Mật Khẩu</span>
                </a>
            </nav>

            <!-- User Footer -->
            <div class="lms-sidebar-footer">
                <div class="lms-user-card">
                    <div class="lms-user-avatar">@initials</div>
                    <div class="lms-user-meta">
                        <div class="lms-user-name">@uname</div>
                        <span class="lms-user-badge">@role</span>
                    </div>
                </div>
                <form method="post" action="/Account/Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="lms-btn-logout">
                        <i class="bi bi-box-arrow-right"></i> Đăng Xuất
                    </button>
                </form>
            </div>
        </aside>
    }

    <!-- ── MAIN VIEWPORT ────────────────────────────────────── -->
    <div class="lms-main">
        @if (Context.Session.GetInt32("UserId") != null)
        {
            <header class="lms-topbar">
                <div class="lms-topbar-left">
                    <h1 class="lms-topbar-title mb-0">@(ViewData["Title"] ?? "Dashboard")</h1>
                </div>
                <div class="lms-topbar-right">
                    <button class="lms-icon-btn" title="Thông báo">
                        <i class="bi bi-bell"></i>
                    </button>
                    <a href="/Account/ChangePassword" class="lms-icon-btn" title="Cài đặt">
                        <i class="bi bi-gear"></i>
                    </a>
                </div>
            </header>
        }

        <!-- Alerts -->
        <div class="lms-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius:12px;border:none;background:#ECFDF5;color:#065F46;">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius:12px;border:none;background:#FEF2F2;color:#991B1B;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

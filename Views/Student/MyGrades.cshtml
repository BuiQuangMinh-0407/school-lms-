@model List<SchoolManagement.Models.DBNew2026.BaiNop>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Bảng Điểm Của Tôi";
}

<div class="d-flex align-items-center mb-4">
    <a href="/Student/Index" class="btn-wb-outline me-3"><i class="bi bi-arrow-left"></i> Quay lại</a>
    <div>
        <h2 class="fw-bold mb-0" style="font-size:1.4rem;color:#0F172A;"><i class="bi bi-patch-check-fill text-success me-2"></i>Bảng Điểm Của Tôi</h2>
        <small class="text-muted">Tổng hợp điểm số và nhận xét từ giảng viên cho các bài tập đã làm</small>
    </div>
</div>

<div class="wb-card">
    <div class="table-responsive">
        <table class="wb-table">
            <thead>
                <tr>
                    <th>Lớp Học</th>
                    <th>Bài Tập</th>
                    <th>Điểm Số</th>
                    <th>Nhận Xét Của Giảng Viên</th>
                    <th>Thời Điểm Nộp</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sub in Model)
                {
                    var g = sub.Diem ?? 0;
                    var badgeClass = g >= 8.0m ? "success" : g >= 5.0m ? "warning" : "failed";
                    <tr>
                        <td class="fw-bold">@sub.BaiTap.LopHoc.TenLop</td>
                        <td>@sub.BaiTap.TieuDe</td>
                        <td>
                            <span class="wb-badge @badgeClass" style="font-size:0.95rem;padding:4px 12px;">
                                @g / 10
                            </span>
                        </td>
                        <td><span class="text-muted">@(sub.NhanXet ?? "—")</span></td>
                        <td><small class="text-muted">@sub.NgayNop.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Chưa có bài tập nào được chấm điểm.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model List<SchoolManagement.Models.Class>
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Classes";
}

<h4 class="mb-4"><i class="bi bi-collection me-2"></i>My Enrolled Classes</h4>

<div class="row g-3">
    @foreach (var cls in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title fw-bold">@cls.Name</h5>
                    <p class="card-text text-muted small">@(cls.Description ?? "No description")</p>
                    <div class="text-muted small mb-3">
                        <span class="me-3"><i class="bi bi-journal-richtext me-1"></i>@cls.Lessons.Count lesson(s)</span>
                        <span><i class="bi bi-clipboard me-1"></i>@cls.Assignments.Count assignment(s)</span>
                    </div>
                    <a href="/Student/ClassDetail/@cls.Id" class="btn btn-sm btn-outline-primary w-100">
                        <i class="bi bi-door-open me-1"></i>Enter Class
                    </a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info">You are not enrolled in any classes yet. Contact your administrator.</div>
        </div>
    }
</div>

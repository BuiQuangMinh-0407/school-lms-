@model SchoolManagement.Models.DBNew2026.BaiHoc
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.TieuDe;
}

<div class="d-flex align-items-center mb-4">
    <a href="/Student/ClassDetail/@Model.LopHocId" class="btn-wb-outline me-3"><i class="bi bi-arrow-left"></i> Quay lại</a>
    <div>
        <h2 class="fw-bold mb-0" style="font-size:1.35rem;color:#0F172A;">@Model.TieuDe</h2>
        <small class="text-muted">
            <i class="bi bi-calendar3 me-1"></i> Ngày xuất bản: @((Model.NgayXuatBan ?? Model.NgayTao).ToLocalTime().ToString("dd/MM/yyyy"))
        </small>
    </div>
</div>

<div class="wb-card p-4">
    <div style="white-space:pre-wrap; line-height:1.8; color:#334155; font-size:1rem;">@Model.NoiDung</div>
</div>

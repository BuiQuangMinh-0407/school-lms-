@model SchoolManagement.Models.Lesson
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Title;
}

<div class="d-flex align-items-center mb-4">
    <a href="/Student/ClassDetail/@Model.ClassId" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
    <div>
        <h4 class="mb-0">@Model.Title</h4>
        <small class="text-muted">
            <i class="bi bi-person me-1"></i>@Model.Teacher.FullName &nbsp;|&nbsp;
            Published @Model.PublishedAt?.ToLocalTime().ToString("dd/MM/yyyy")
        </small>
    </div>
</div>

<div class="card p-4">
    <div style="white-space:pre-wrap; line-height:1.8">@Model.Content</div>
</div>

@model SchoolManagement.ViewModels.SubmitAssignmentViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Submit Assignment";
    var existing = ViewBag.ExistingSubmission as SchoolManagement.Models.AssignmentSubmission;
    bool alreadySubmitted = existing != null;
    bool isPastDue = Model.DueDate < DateTime.UtcNow;
}

<div class="d-flex align-items-center mb-4">
    <button onclick="history.back()" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></button>
    <div>
        <h4 class="mb-0"><i class="bi bi-upload me-2"></i>@Model.AssignmentTitle</h4>
        <small class="@(isPastDue ? "text-danger fw-bold" : "text-muted")">
            Due: @Model.DueDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            @if (isPastDue) { <span>(OVERDUE)</span> }
        </small>
    </div>
</div>

<div class="row g-4">
    <!-- Assignment instructions -->
    <div class="col-lg-5">
        <div class="card p-4">
            <h6 class="fw-semibold"><i class="bi bi-info-circle me-2"></i>Instructions</h6>
            <div style="white-space:pre-wrap">@Model.AssignmentDescription</div>
        </div>

        @if (alreadySubmitted)
        {
            <div class="card p-3 mt-3 border-success">
                <h6 class="text-success fw-semibold"><i class="bi bi-check-circle me-2"></i>Already Submitted</h6>
                <small class="text-muted d-block">Submitted @existing!.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                @if (existing.Grade.HasValue)
                {
                    <div class="mt-2">
                        <span class="badge bg-success fs-6">Grade: @existing.Grade / 100</span>
                        @if (!string.IsNullOrEmpty(existing.Feedback))
                        {
                            <p class="mt-2 text-muted small"><strong>Feedback:</strong> @existing.Feedback</p>
                        }
                    </div>
                }
                else
                {
                    <span class="badge bg-warning text-dark mt-2">Awaiting grade</span>
                }
            </div>
        }
    </div>

    <!-- Submission form -->
    <div class="col-lg-7">
        <div class="card p-4">
            <h6 class="fw-semibold mb-3">
                @(alreadySubmitted ? "Update Your Submission" : "Your Answer")
            </h6>
            <form asp-action="SubmitAssignment" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="AssignmentId" type="hidden" />
                <input asp-for="AssignmentTitle" type="hidden" />
                <input asp-for="AssignmentDescription" type="hidden" />
                <input asp-for="DueDate" type="hidden" />

                <div asp-validation-summary="All" class="alert alert-danger py-2"></div>

                <textarea asp-for="SubmissionContent" class="form-control" rows="12"
                    placeholder="Type your answer here..."></textarea>
                <span asp-validation-for="SubmissionContent" class="text-danger small"></span>

                <button type="submit" class="btn btn-success w-100 mt-3">
                    <i class="bi bi-send me-1"></i>@(alreadySubmitted ? "Re-submit Answer" : "Submit Answer")
                </button>
            </form>
        </div>
    </div>
</div>
